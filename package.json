{
  "name": "ionov-storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server",
    "dev": "hydrogen skills check --mode=warn && vite dev",
    "dev:https": "hydrogen skills check --mode=warn && vite dev",
    "preview": "react-router build && vite preview",
    "gql:check": "node scripts/gql-check.mjs",
    "typecheck": "react-router typegen && tsc && npm run gql:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm run test:template",
    "test:template": "node --test \"__test__/*.test.ts\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:e2e": "playwright test",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "seed:verify": "node --experimental-strip-types scripts/seed-verify.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@remix-run/cookie": "^0.6.0",
    "@remix-run/session": "^0.4.2",
    "@shopify/hydrogen": "^2026.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.15.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "7.15.1",
    "@shopify/cli": "4.8.1",
    "@shopify/mini-oxygen": "^4.3.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12 || ^24"
  }
}
